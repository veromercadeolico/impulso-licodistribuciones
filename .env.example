# Cadena de conexión de la base de datos Neon (PostgreSQL)
DATABASE_URL=
# Secreto para firmar las sesiones: mínimo 32 caracteres aleatorios
SESSION_SECRET=
# URL pública de la app. Se usa en el enlace de registro de vendedores y en los correos
APP_URL=http://localhost:3000
# Código del enlace de registro de vendedores (/registro?c=CODIGO). Sin él, el registro por enlace queda apagado
REGISTRO_CODIGO=
# 1 = ambiente de demostración: muestra el aviso de datos ficticios, prellena la cédula en los enlaces
# de la guía y deja registrar la entrada a cualquier hora. Déjalo vacío para la operación real
MODO_DEMO=
# Opcional: sin estas dos variables los correos quedan en la bandeja de salida de la app
RESEND_API_KEY=
CORREO_REMITENTE=
